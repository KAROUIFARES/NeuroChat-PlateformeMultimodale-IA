# =============================================================================
#  NeuroChat - Gabarit des variables d'environnement locales
#  Fichier : .env.example
#  Rôle    : Modèle de configuration à renommer en .env et à compléter
# =============================================================================

# Port d'écoute du serveur local
PORT=8000

# Clé API Groq (gsk_...) à récupérer sur https://console.groq.com
GROQ_API_KEY=votre_cle_api_groq_ici

# URL publique de votre serveur Google Colab (Localtunnel) générée par le notebook
COLAB_TUNNEL_URL=https://votre-url-localtunnel.loca.lt
